#!/bin/sh
set -eu
bundle_root="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
export APPDIR="$bundle_root"
export PATH="$bundle_root/usr/bin:$PATH"
missing="$(LC_ALL=C ldd "$bundle_root/usr/bin/vk-fast" 2>&1 | sed -n '/not found/p')"
if ! command -v fc-match >/dev/null 2>&1; then
    missing="${missing}
fontconfig (fc-match) not found"
fi
if [ -n "$missing" ]; then
    message="VK Fast requires system PipeWire and fontconfig (glibc 2.39+). Install the packages supplied by your distribution.\n\n$missing"
    printf '%b\n' "$message" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title='VK Fast' --text="$message" --no-markup || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title 'VK Fast' --error "$message" || true
    fi
    exit 1
fi
exec "$bundle_root/usr/bin/vk-fast" "$@"
