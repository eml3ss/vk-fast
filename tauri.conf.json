{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VK Fast",
  "version": "0.1.1",
  "identifier": "io.github.eml3ss.vkfast",
  "build": {
    "frontendDist": "webview-assets"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "capabilities": [
        {
          "identifier": "vk-login-no-ipc",
          "description": "The official VK sign-in page receives no native permissions.",
          "windows": [
            "vk-login"
          ],
          "permissions": []
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "assets/vk-fast-icon.ico",
      "assets/vk-fast-icon.png"
    ]
  }
}
